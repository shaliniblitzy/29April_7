# =====================================================================
# Whoville-Client E2E Test Suite - Environment Variable Template
# =====================================================================
# Copy this file to `.env.e2e` (gitignored) and fill in real values for
# local development. CI runners receive these values from secrets.
#
# All variables documented below are referenced by playwright.config.ts,
# e2e/global-setup.ts, and the mock-api / auth fixtures.
# =====================================================================

# ---------------------------------------------------------------------
# Required for every run
# ---------------------------------------------------------------------

# Base URL of the running Whoville-Client Angular dev/prod build.
# Used as the default baseURL for every `await page.goto('/...')` call.
# Local default: http://localhost:4200 (ng serve)
E2E_BASE_URL=http://localhost:4200

# API mode for the suite.
#   mock = (default) every /api/** call is intercepted by page.route()
#   live = bypass interceptors and hit the real backend (nightly only)
E2E_API_MODE=mock

# Set MOCK_API to "true" to force-enable the mock-api fixture even when
# E2E_API_MODE is unset (used by some CI lanes).
MOCK_API=true

# ---------------------------------------------------------------------
# Authentication (required for storageState generation)
# ---------------------------------------------------------------------

# Canonical authenticated test user credentials. The global-setup.ts
# hook performs a one-time login and caches the resulting cookies +
# localStorage in e2e/storage-states/<role>.json.
E2E_TEST_USER_USERNAME=
E2E_TEST_USER_PASSWORD=

# Optional per-role overrides for RBAC tests in Tier 3.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
E2E_VIEWER_USERNAME=
E2E_VIEWER_PASSWORD=
E2E_RESTRICTED_USERNAME=
E2E_RESTRICTED_PASSWORD=

# ---------------------------------------------------------------------
# CI hints (set automatically by CI - leave blank locally)
# ---------------------------------------------------------------------

# Set to "true" by GitHub Actions / Azure DevOps automatically.
# Triggers retry policy, parallel-worker scaling, and reporter selection.
CI=

# Override report output paths (optional).
PLAYWRIGHT_HTML_REPORT=playwright-report
PLAYWRIGHT_JUNIT_OUTPUT_NAME=test-results/junit.xml

# ---------------------------------------------------------------------
# Live-API mode (only required when E2E_API_MODE=live)
# ---------------------------------------------------------------------

# Backend API root for live mode. Examples:
#   https://staging.whoville.example.internal/api
#   https://api.dev.whoville.local
E2E_LIVE_API_BASE_URL=

# Test-data prefix used by factories when running in live mode so that
# the nightly cleanup workflow can identify and remove orphaned entities.
E2E_LIVE_DATA_PREFIX=e2e-test-

# ---------------------------------------------------------------------
# Debug / development helpers
# ---------------------------------------------------------------------

# Set to "1" to launch the Playwright Inspector and pause on each action.
PWDEBUG=

# Override the default test slowMo (ms between actions) when debugging.
PLAYWRIGHT_SLOW_MO=
