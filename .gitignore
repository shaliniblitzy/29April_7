# Git ignore rules for the 29April_7 / Whoville-Client E2E repository.
#
# Sections (in order):
#   - Playwright outputs and artifacts
#   - Test data and authentication state
#   - Environment files
#   - Node.js / npm
#   - Angular / TypeScript build outputs
#   - IDE artifacts
#   - OS artifacts
#   - Coverage and reporting
#   - Logs
#   - Temp and backup files
#
# Per AAP section 0.5.1.1, the following entries are required:
#   playwright-report/, test-results/, e2e/storage-states/*.json,
#   e2e/.cache/, .env.e2e, *.zip
#
# Pattern-syntax reminders:
#   - Trailing slash (folder/) means "directory only".
#   - Leading exclamation (!path) un-ignores a previously-ignored path.
#   - Globs (**) match any nested directory; (*) matches any single segment.
#   - Order matters: un-ignore rules must come AFTER the corresponding
#     ignore rule. Validate with: `git check-ignore -v <path>`.

# === Playwright outputs and artifacts ===
# Generated by `npx playwright test`; uploaded as CI artifacts only.
playwright-report/
test-results/
e2e/.cache/
e2e/test-results/
playwright/.cache/
# Trace zips can each be hundreds of MBs; never commit.
*.zip
# On-failure videos written by `video: 'retain-on-failure'`.
*.webm
# On-failure screenshots written by `screenshot: 'only-on-failure'`.
*.png
# But preserve legitimate fixture screenshots and documentation images.
!e2e/fixtures/**/*.png
!docs/**/*.png
!blitzy/**/*.png
# HTTP Archive captures (Playwright `recordHar`).
*.har
# Standalone trace viewer exports.
trace-viewer.html

# === Test data and authentication state ===
# Auth storageState files are generated per-test-run by global-setup.ts;
# they MUST NOT be committed because they contain session tokens that
# grant access to the running Whoville-Client test environment.
e2e/storage-states/*.json
# But preserve the directory placeholder so the path exists in git
# (created by AAP section 0.5.1.2).
!e2e/storage-states/.gitkeep

# Live-mode entity cleanup logs written by e2e/utils/test-data-cleanup.ts.
e2e/.cleanup-logs/

# Local fixture overrides (developer-specific; never shared).
e2e/fixtures/local/

# === Environment files ===
# Real `.env*` files contain secrets and MUST NOT be committed.
.env
.env.local
.env.*.local
.env.e2e
# But preserve the templates that document required env vars (safe to commit).
!.env.e2e.example
!.env.example

# === Node.js / npm ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/
.yarn/
.pnp.*
package-lock.json.bak
# NOTE: package-lock.json itself is NOT ignored; it is committed for
# reproducible CI builds (per `npm ci` requirement in CI workflows).

# === Angular / TypeScript build outputs ===
dist/
dist-e2e/
out-tsc/
tmp/
# Angular CLI 12+ persistent build cache.
.angular/cache/
# TypeScript incremental compile metadata.
*.tsbuildinfo
# Sourcemaps generated by tsc; not committed.
*.js.map
*.d.ts.map
# tsconfig.e2e.json `outDir` per AAP section 0.6.2.
.tsc-output/
e2e/.tsc-output/

# === IDE artifacts ===
# VS Code: ignore everything by default, then opt-in to workspace-shared
# settings that the team agrees to commit.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# IntelliJ / WebStorm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# === OS artifacts ===
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~

# === Coverage and reporting ===
# Route-coverage report emitted by e2e/scripts/coverage-report.ts
# (per AAP section 0.5.1.15).
e2e-coverage.html
# Generic coverage outputs (Istanbul, c8, nyc, lcov).
coverage/
.nyc_output/
*.lcov
# Cache from coverage-report.ts incremental runs.
e2e/scripts/.coverage-cache/
# Flake-rate analysis report emitted by e2e/scripts/flake-detector.ts.
flake-report.json

# === Logs ===
*.log
logs/
debug.log
playwright-debug.log

# === Temp and backup files ===
*.swp
*.swo
*.bak
*.tmp
.tmp/
